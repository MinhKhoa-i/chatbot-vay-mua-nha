APP_NAME=Home Loan Chatbot API
APP_VERSION=0.1.0
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173
POSTGRES_DB=home_loan_db
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=replace-me
POSTGRES_PORT=5432
# API and Alembic run on the host; Compose overrides the worker URL to use db:5432.
DATABASE_URL=postgresql+asyncpg://postgres_user:replace-me@127.0.0.1:5432/home_loan_db
# Local directory shared with the Docker worker; run the host API from ai_service/.
KNOWLEDGE_SNAPSHOT_DIR=./data/snapshots
# Optional: override the worker DB URL if credentials need URL encoding.
# WORKER_DATABASE_URL=postgresql+asyncpg://postgres_user:replace-me@db:5432/home_loan_db
# Optional: embedding endpoint reachable from the worker container.
WORKER_EMBEDDING_BASE_URL=http://host.docker.internal:20128/v1
EMBEDDING_BASE_URL=http://host.docker.internal:20128/v1
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIMENSIONS=1536
# OpenAI-compatible chat completion gateway (the chat model ID is fixed by implement.md).
LLM_BASE_URL=http://localhost:20128/v1
LLM_MODEL=cx/gpt-5.6-sol
LLM_TIMEOUT_SECONDS=45
LLM_API_KEY=replace-with-provider-key
# Generate an independent 32-byte key and base64 encode it; do not reuse the LLM key.
DATA_ENCRYPTION_KEY_BASE64=
